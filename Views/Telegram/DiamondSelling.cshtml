
@{
    ViewData["Title"] = "Diamond Selling";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mobile Legends - Diamond Top Up</title>

   <link href="~/css/DiamondSelling.css" rel="stylesheet" />
</head>

<body>

    <div class="background-glow">
        <div class="orb one"></div>
        <div class="orb two"></div>
        <div class="orb three"></div>
    </div>

    <main class="page">

        <div class="top-title">

            <div class="small">
                မြန်ဆန် • လုံခြုံ • ချက်ချင်း
            </div>

            <h1>
                DIAMOND ဖြည့်မယ်
            </h1>

            <p>
                Mobile Legends အကောင့်အတွက် Diamond ဖြည့်သွင်းရန်
            </p>

        </div>


        <div class="game-header">

            <div class="game-icon">
                💎
            </div>

            <div>

                <h2>
                    Mobile Legends: Bang Bang
                </h2>

                <span>
                    မိမိဝယ်ယူလိုသော Package ကို ရွေးချယ်ပါ
                </span>

            </div>

        </div>


        <!-- PLAYER INFORMATION -->

        <div class="input-row">

            <div class="input-group">

                <label>
                    PLAYER ID
                </label>

                <input type="text"
                       id="userId"
                       class="input-box"
                       placeholder="Player ID ထည့်ပါ"
                       autocomplete="off">

            </div>


            <div class="input-group">

                <label>
                    SERVER ID
                </label>

                <input type="text"
                       id="serverId"
                       class="input-box"
                       placeholder="Server ID ထည့်ပါ"
                       autocomplete="off">

            </div>

        </div>


        <!-- SPECIAL PACKAGES -->

        <div class="section-title">

            <h3>
                🎁 အထူး Package များ
            </h3>

            <span>
                လူကြိုက်များသော Package များ
            </span>

        </div>


        <div id="specialGrid" class="diamond-grid">
        </div>


        <!-- RECHARGE EVENT -->

        <div class="section-title" style="margin-top:35px;">

            <h3>
                🔥 Recharge Event
            </h3>

            <span>
                Bonus Diamond ပါဝင်သည်
            </span>

        </div>


        <div id="rechargeGrid" class="diamond-grid">
        </div>


        <!-- NORMAL DIAMONDS -->

        <div class="section-title" style="margin-top:35px;">

            <h3>
                💎 Diamond Package များ
            </h3>

            <span>
                မိမိလိုအပ်သလောက် ရွေးချယ်ပါ
            </span>

        </div>


        <div id="diamondGrid" class="diamond-grid">
        </div>


        <!-- LOADING -->

        <div id="loading" class="loading">

            <div class="loader"></div>

            Diamond ဈေးနှုန်းများ ရယူနေပါသည်...

        </div>


        <div id="error" class="error"></div>


        <!-- PURCHASE -->

        <div id="purchaseBar"
             class="purchase-bar"
             style="display:none;">
             
            <div class="selected-info">

                ရွေးချယ်ထားသော Package

                <strong id="selectedText">
                    -
                </strong>

            </div>


            <button id="buyButton"
                    class="buy-button"
                    type="button">
                ဆက်လက်ဝယ်ယူမည် →
            </button>

        </div>      
        
        
    </main>

    <!-- PAYMENT METHOD CHOOSE MODAL -->

<div id="paymentMethodModal" class="payment-modal">

<div class="payment-backdrop"></div>

<div class="payment-box payment-method-box">

    <button type="button"
            class="payment-close"
            onclick="closePaymentMethodModal()">
        ×
    </button>

    <div class="payment-header">

        <div class="payment-icon">
            💳
        </div>

        <h2>Payment Method ရွေးပါ</h2>

        <p>
            ငွေပေးချေမည့် Payment ကို ရွေးပါ
        </p>

    </div>


    <div class="payment-method-buttons">

        <!-- KPay -->
        <button type="button"
                class="payment-method-select kpay"
                onclick="choosePaymentMethod('KPay')">

            <span class="payment-method-logo">
                💚
            </span>

            <span class="payment-method-name">
                KPay
            </span>

            <small>
                KPay ဖြင့် ငွေလွှဲမည်
            </small>

        </button>


        <!-- WavePay -->
        <button type="button"
                class="payment-method-select wavepay"
                onclick="choosePaymentMethod('WavePay')">

            <span class="payment-method-logo">
                💙
            </span>

            <span class="payment-method-name">
                WavePay
            </span>

            <small>
                WavePay ဖြင့် ငွေလွှဲမည်
            </small>

        </button>

    </div>

</div>

</div>

    <!-- PAYMENT MODAL -->
    <div id="paymentModal" class="payment-modal">

        <div class="payment-backdrop"></div>

        <div class="payment-box">

            <button type="button"
                    class="payment-close"
                    onclick="closePaymentModal()">
                ×
            </button>

            <!-- Header -->
            <div class="payment-header">

                <div class="payment-icon">
                    💳
                </div>

                <h2>Payment လုပ်မည်</h2>

                <p>
                    ငွေလွှဲပြီး Payment Screenshot တင်ပေးပါ
                </p>

            </div>


            <!-- Order Summary -->
            <div class="order-summary">

                <div class="summary-row">
                    <span>Player ID</span>
                    <strong id="paymentUserId">-</strong>
                </div>

                <div class="summary-row">
                    <span>Server ID</span>
                    <strong id="paymentServerId">-</strong>
                </div>

                <div class="summary-row">
                    <span>Package</span>
                    <strong id="paymentPackage">-</strong>
                </div>

                <div class="summary-row total">
                    <span>Total</span>
                    <strong id="paymentPrice">0 Ks</strong>
                </div>

            </div>


            <!-- QR -->

<div class="qr-section"
     id="qrSection"
     style="display:none;">

<div class="qr-title"
     id="selectedPaymentTitle">
    📱 Scan to Pay
</div>


<div class="qr-box">

    <img id="paymentQr"
         src=""
         alt="Payment QR">

</div>


<div class="qr-price"
     id="qrPrice">
    0 Ks
</div>


<p class="qr-note">
    QR ကို Scan ဖတ်ပြီး အထက်ပါ Amount အတိုင်း
    ငွေလွှဲပေးပါ
</p>

</div>



            <!-- Screenshot -->
            <div class="upload-section">

                <label class="upload-label">
                    📸 Payment Screenshot
                </label>

                <label for="paymentScreenshot"
                       class="upload-box">

                    <div id="uploadPreview">

                        <span class="upload-icon">
                            📷
                        </span>

                        <span>
                            Screenshot ရွေးရန်
                        </span>

                        <small>
                            JPG / PNG
                        </small>

                    </div>

                </label>

                <input type="file"
                       id="paymentScreenshot"
                       accept="image/png,image/jpeg"
                       hidden>
                       
            </div>


            <!-- Submit -->
            <button type="button"
                    id="submitOrderButton"
                    class="submit-order">

                <span>✓</span>
                ငွေလွှဲပြီး Order တင်မည်

            </button>

        </div>

    </div>
    <script src="~/js/DiamondSelling.js" asp-append-version="true"></script>
</body>
</html>